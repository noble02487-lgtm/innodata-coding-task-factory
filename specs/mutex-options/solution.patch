+    def _check_exclusive_options(self, ctx: Context) -> None:
+        """Raise a usage error if two or more options that share an
+        ``exclusive_group`` were explicitly provided (on the command line
+        or through an environment variable). Values coming from defaults
+        or the default map do not count as provided.
+
+        :meta private:
+        """
+        given: cabc.MutableMapping[str, list[Option]] = {}
+
+        for param in self.params:
+            if not isinstance(param, Option) or param.exclusive_group is None:
+                continue
+
+            source = ctx.get_parameter_source(param.name)
+
+            if source in (ParameterSource.COMMANDLINE, ParameterSource.ENVIRONMENT):
+                given.setdefault(param.exclusive_group, []).append(param)
+
+        for group_name, options in given.items():
+            if len(options) > 1:
+                names = ", ".join(
+                    next(
+                        (o for o in opt.opts if o.startswith("--")),
+                        opt.opts[0] if opt.opts else opt.name,
+                    )
+                    for opt in options
+                )
+                raise UsageError(
+                    _(
+                        "The options {names} are mutually exclusive"
+                        " (group {group!r})."
+                    ).format(names=names, group=group_name),
+                    ctx=ctx,
+                )
+
